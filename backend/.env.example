# ChalkBox model configuration.
# Every model is reached through an OpenAI-compatible API, so switching between
# laptop (Ollama), NVIDIA's hosted API catalog, and a DGX Spark (vLLM / NIM)
# only means changing the values below. Copy this file to .env and pick a preset.

# ---------- Preset A: Ollama on this machine (offline) ----------
TEXT_BASE_URL=http://localhost:11434/v1
TEXT_API_KEY=ollama
TEXT_MODEL=qwen3:4b-instruct

VISION_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=ollama
VISION_MODEL=qwen2.5vl:3b

# ---------- Preset B: NVIDIA API catalog (build.nvidia.com) ----------
# TEXT_BASE_URL=https://integrate.api.nvidia.com/v1
# TEXT_API_KEY=nvapi-your-key-here
# TEXT_MODEL=<a Qwen text model id listed on build.nvidia.com>
# VISION_BASE_URL=https://integrate.api.nvidia.com/v1
# VISION_API_KEY=nvapi-your-key-here
# VISION_MODEL=<a vision model id listed on build.nvidia.com>

# ---------- Preset C: DGX Spark running vLLM or NIM ----------
# TEXT_BASE_URL=http://<spark-ip>:8000/v1
# TEXT_API_KEY=not-needed
# TEXT_MODEL=<model name served by vLLM/NIM>
# VISION_BASE_URL=http://<spark-ip>:8001/v1
# VISION_API_KEY=not-needed
# VISION_MODEL=<vision model name served by vLLM/NIM>

# Use instruct (non-thinking) models: "thinking" models spend minutes on hidden reasoning.
# This switch only helps models that understand /no_think.
DISABLE_THINKING=true

# Seconds before a model call gives up (CPU-only laptops need a long timeout).
REQUEST_TIMEOUT=300

# Where the SQLite database and uploaded photos are stored.
DATA_DIR=data

# How many AI jobs (worksheets, lessons, practice sheets) run at the same time.
# 1 on a CPU-only laptop; raise it on a DGX Spark to process a whole class in parallel.
WORKERS=1

# Longest reply a model may write. Stops runaway answers from hitting the timeout.
MAX_TOKENS=1500
